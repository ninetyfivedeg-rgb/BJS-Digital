{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Data anggota resmi Koperasi Brama Jaya Sejahtera",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Nomor register anggota koperasi (contoh: BJS-001)"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap anggota"
        },
        "nik": {
          "type": "string",
          "description": "Nomor Induk Kependudukan (NIK)"
        },
        "phone": {
          "type": "string",
          "description": "Nomor telepon / WhatsApp"
        },
        "job": {
          "type": "string",
          "description": "Unit kerja / Dinas / Pos Pemadam Kebakaran"
        },
        "address": {
          "type": "string",
          "description": "Alamat domisili"
        },
        "status": {
          "type": "string",
          "description": "Status keanggotaan (aktif, pasif, keluar, nonaktif)"
        },
        "joinDate": {
          "type": "string",
          "description": "Tanggal bergabung menjadi anggota"
        },
        "joinYear": {
          "type": "string",
          "description": "Tahun bergabung"
        },
        "calculatedMonths": {
          "type": "number",
          "description": "Akumulasi bulan simpanan wajib"
        },
        "initialTotalSavings": {
          "type": "number",
          "description": "Total simpanan pokok dan wajib"
        },
        "notes": {
          "type": "string",
          "description": "Catatan tambahan anggota"
        }
      },
      "required": ["id", "name", "status"]
    },
    "SavingsTransaction": {
      "title": "SavingsTransaction",
      "description": "Catatan transaksi simpanan pokok, wajib, dan berjangka",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode unik transaksi simpanan"
        },
        "memberId": {
          "type": "string",
          "description": "ID anggota pemilik simpanan"
        },
        "memberName": {
          "type": "string",
          "description": "Nama anggota"
        },
        "type": {
          "type": "string",
          "description": "Jenis simpanan (pokok, wajib, berjangka)"
        },
        "txType": {
          "type": "string",
          "description": "Tipe mutasi (setor atau tarik)"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi dalam Rupiah"
        },
        "date": {
          "type": "string",
          "description": "Tanggal transaksi"
        },
        "adminName": {
          "type": "string",
          "description": "Petugas yang mencatat transaksi"
        },
        "termMonths": {
          "type": "number",
          "description": "Lama jangka waktu simpanan berjangka"
        },
        "annualInterestRate": {
          "type": "number",
          "description": "Tingkat bunga tahunan"
        },
        "maturityDate": {
          "type": "string",
          "description": "Tanggal jatuh tempo simpanan berjangka"
        },
        "accruedInterest": {
          "type": "number",
          "description": "Bunga berjalan"
        },
        "interestPaymentSchedule": {
          "type": "string",
          "description": "Jadwal pencairan bunga"
        },
        "statusBerjangka": {
          "type": "string",
          "description": "Status simpanan berjangka"
        },
        "completedDate": {
          "type": "string",
          "description": "Tanggal penyelesaian simpanan berjangka"
        },
        "notes": {
          "type": "string",
          "description": "Catatan simpanan"
        }
      },
      "required": ["id", "memberId", "amount", "type", "txType", "date"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Data pinjaman anggota unit simpan pinjam",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode pinjaman (contoh: PJM-2026-001)"
        },
        "memberId": {
          "type": "string",
          "description": "ID anggota peminjam"
        },
        "memberName": {
          "type": "string",
          "description": "Nama anggota peminjam"
        },
        "amount": {
          "type": "number",
          "description": "Plafon pinjaman yang dicairkan"
        },
        "tenorMonths": {
          "type": "number",
          "description": "Lama tenor pinjaman dalam bulan"
        },
        "interestRatePerMonth": {
          "type": "number",
          "description": "Bunga flat per bulan"
        },
        "adminFee": {
          "type": "number",
          "description": "Biaya administrasi pinjaman"
        },
        "monthlyPrincipal": {
          "type": "number",
          "description": "Pokok angsuran per bulan"
        },
        "monthlyInterest": {
          "type": "number",
          "description": "Bunga angsuran per bulan"
        },
        "monthlyTotal": {
          "type": "number",
          "description": "Total cicilan per bulan"
        },
        "totalLoanAmount": {
          "type": "number",
          "description": "Total pinjaman beserta bunga"
        },
        "status": {
          "type": "string",
          "description": "Status pinjaman (diajukan, review, disetujui, dicairkan, aktif, lunas, ditolak)"
        },
        "startDate": {
          "type": "string",
          "description": "Tanggal pencairan pinjaman"
        },
        "purpose": {
          "type": "string",
          "description": "Keperluan pengajuan pinjaman"
        },
        "approvedDate": {
          "type": "string",
          "description": "Tanggal persetujuan pinjaman"
        },
        "disbursedDate": {
          "type": "string",
          "description": "Tanggal pencairan"
        },
        "schedules": {
          "type": "array",
          "description": "Jadwal dan rincian angsuran pinjaman"
        },
        "notes": {
          "type": "string",
          "description": "Catatan pinjaman"
        }
      },
      "required": ["id", "memberId", "amount", "tenorMonths", "status"]
    },
    "LoanRepayment": {
      "title": "LoanRepayment",
      "description": "Catatan pembayaran cicilan angsuran pinjaman",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode kwitansi angsuran"
        },
        "loanId": {
          "type": "string",
          "description": "Nomor referensi pinjaman"
        },
        "memberId": {
          "type": "string",
          "description": "ID anggota peminjam"
        },
        "memberName": {
          "type": "string",
          "description": "Nama anggota peminjam"
        },
        "installmentNo": {
          "type": "number",
          "description": "Angsuran ke berapa"
        },
        "principalAmount": {
          "type": "number",
          "description": "Porsi pokok pinjaman"
        },
        "interestAmount": {
          "type": "number",
          "description": "Porsi jasa bunga"
        },
        "penaltyAmount": {
          "type": "number",
          "description": "Denda keterlambatan"
        },
        "totalPaid": {
          "type": "number",
          "description": "Total uang yang dibayarkan"
        },
        "date": {
          "type": "string",
          "description": "Tanggal pembayaran"
        },
        "adminName": {
          "type": "string",
          "description": "Petugas penerima angsuran"
        },
        "notes": {
          "type": "string",
          "description": "Catatan angsuran"
        }
      },
      "required": ["id", "loanId", "memberId", "totalPaid", "date"]
    },
    "CashFlowRecord": {
      "title": "CashFlowRecord",
      "description": "Catatan arus kas umum koperasi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID catatan arus kas"
        },
        "date": {
          "type": "string",
          "description": "Tanggal transaksi kas"
        },
        "type": {
          "type": "string",
          "description": "Jenis kas (masuk atau keluar)"
        },
        "category": {
          "type": "string",
          "description": "Kategori transaksi arus kas"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi"
        },
        "description": {
          "type": "string",
          "description": "Uraian transaksi"
        },
        "referenceId": {
          "type": "string",
          "description": "ID referensi transaksi terkait"
        }
      },
      "required": ["id", "date", "type", "amount", "category"]
    },
    "SimpanPinjamCashMutation": {
      "title": "SimpanPinjamCashMutation",
      "description": "Mutasi penyesuaian saldo kas unit simpan pinjam (USP)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Nomor bukti transaksi mutasi kas (contoh: KAS-SP-xxx)"
        },
        "date": {
          "type": "string",
          "description": "Tanggal transaksi"
        },
        "type": {
          "type": "string",
          "description": "Jenis mutasi (penambahan atau pengurangan)"
        },
        "category": {
          "type": "string",
          "description": "Kategori penyesuaian kas"
        },
        "amount": {
          "type": "number",
          "description": "Nominal mutasi dalam Rupiah"
        },
        "description": {
          "type": "string",
          "description": "Keterangan transaksi"
        },
        "sourceOrRecipient": {
          "type": "string",
          "description": "Sumber dana atau pihak penerima"
        },
        "recordedBy": {
          "type": "string",
          "description": "Nama petugas pencatat"
        },
        "notes": {
          "type": "string",
          "description": "Catatan transaksi"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan"
        }
      },
      "required": ["id", "date", "type", "category", "amount", "description"]
    },
    "BusinessUnitTransaction": {
      "title": "BusinessUnitTransaction",
      "description": "Transaksi unit usaha koperasi (APAR, alat kebakaran, sembako, atribut)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode transaksi unit usaha"
        },
        "unitKey": {
          "type": "string",
          "description": "Kunci unit usaha terkait"
        },
        "date": {
          "type": "string",
          "description": "Tanggal transaksi"
        },
        "type": {
          "type": "string",
          "description": "Jenis transaksi (penjualan, hpp_beli_barang, beban_operasional)"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi"
        },
        "description": {
          "type": "string",
          "description": "Uraian transaksi barang / jasa"
        }
      },
      "required": ["id", "date", "type", "amount"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "#/entities/Member",
      "description": "Koleksi data anggota koperasi"
    },
    "/savings/{savingsId}": {
      "schema": "#/entities/SavingsTransaction",
      "description": "Koleksi transaksi simpanan anggota"
    },
    "/loans/{loanId}": {
      "schema": "#/entities/Loan",
      "description": "Koleksi pinjaman anggota unit simpan pinjam"
    },
    "/repayments/{repaymentId}": {
      "schema": "#/entities/LoanRepayment",
      "description": "Koleksi riwayat angsuran pinjaman"
    },
    "/cashFlow/{cashFlowId}": {
      "schema": "#/entities/CashFlowRecord",
      "description": "Koleksi buku kas umum koperasi"
    },
    "/spCashMutations/{mutationId}": {
      "schema": "#/entities/SimpanPinjamCashMutation",
      "description": "Koleksi mutasi penyesuaian kas unit simpan pinjam"
    },
    "/businessTransactions/{transactionId}": {
      "schema": "#/entities/BusinessUnitTransaction",
      "description": "Koleksi transaksi unit usaha"
    }
  }
}
