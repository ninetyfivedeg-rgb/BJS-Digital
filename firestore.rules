rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ninetyfive.deg@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Schema Validators
    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'status'])
        && data.keys().hasOnly(['id', 'name', 'nik', 'phone', 'job', 'address', 'status', 'joinDate', 'joinYear', 'calculatedMonths', 'initialTotalSavings', 'notes'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.status is string && (data.status in ['aktif', 'pasif', 'keluar', 'nonaktif', 'calon'])
        && (!('nik' in data) || (data.nik is string && data.nik.size() <= 30))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('job' in data) || (data.job is string && data.job.size() <= 150))
        && (!('address' in data) || (data.address is string && data.address.size() <= 255))
        && (!('joinDate' in data) || (data.joinDate is string && data.joinDate.size() <= 30))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidSavings(data) {
      return data.keys().hasAll(['id', 'memberId', 'amount', 'type', 'txType', 'date'])
        && data.keys().hasOnly(['id', 'memberId', 'memberName', 'type', 'txType', 'amount', 'date', 'adminName', 'termMonths', 'annualInterestRate', 'maturityDate', 'accruedInterest', 'interestPaymentSchedule', 'statusBerjangka', 'completedDate', 'notes'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.memberId is string && data.memberId.size() > 0 && data.memberId.size() <= 64
        && data.type is string && (data.type in ['pokok', 'wajib', 'berjangka', 'sukarela'])
        && data.txType is string && (data.txType in ['setor', 'tarik'])
        && data.amount is number && data.amount > 0
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && (!('memberName' in data) || (data.memberName is string && data.memberName.size() <= 150))
        && (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['id', 'memberId', 'amount', 'tenorMonths', 'status'])
        && data.keys().hasOnly(['id', 'memberId', 'memberName', 'amount', 'tenorMonths', 'interestRatePerMonth', 'adminFee', 'monthlyPrincipal', 'monthlyInterest', 'monthlyTotal', 'totalLoanAmount', 'status', 'startDate', 'purpose', 'approvedDate', 'disbursedDate', 'schedules', 'notes'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.memberId is string && data.memberId.size() > 0 && data.memberId.size() <= 64
        && data.amount is number && data.amount > 0
        && data.tenorMonths is number && data.tenorMonths > 0 && data.tenorMonths <= 120
        && data.status is string && (data.status in ['diajukan', 'review', 'disetujui', 'dicairkan', 'menunggu', 'aktif', 'lunas', 'ditolak'])
        && (!('memberName' in data) || (data.memberName is string && data.memberName.size() <= 150))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 30))
        && (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 255))
        && (!('schedules' in data) || (data.schedules is list && data.schedules.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidRepayment(data) {
      return data.keys().hasAll(['id', 'loanId', 'memberId', 'totalPaid', 'date'])
        && data.keys().hasOnly(['id', 'loanId', 'memberId', 'memberName', 'installmentNo', 'principalAmount', 'interestAmount', 'penaltyAmount', 'totalPaid', 'date', 'adminName', 'notes'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.loanId is string && data.loanId.size() > 0 && data.loanId.size() <= 64
        && data.memberId is string && data.memberId.size() > 0 && data.memberId.size() <= 64
        && data.totalPaid is number && data.totalPaid > 0
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && (!('memberName' in data) || (data.memberName is string && data.memberName.size() <= 150))
        && (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidCashFlow(data) {
      return data.keys().hasAll(['id', 'date', 'type', 'amount', 'category'])
        && data.keys().hasOnly(['id', 'date', 'type', 'category', 'amount', 'description', 'referenceId'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && data.type is string && (data.type in ['masuk', 'keluar'])
        && data.amount is number && data.amount > 0
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 255))
        && (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 64));
    }

    function isValidSpCashMutation(data) {
      return data.keys().hasAll(['id', 'date', 'type', 'category', 'amount', 'description'])
        && data.keys().hasOnly(['id', 'date', 'type', 'category', 'amount', 'description', 'sourceOrRecipient', 'recordedBy', 'notes', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && data.type is string && (data.type in ['penambahan', 'pengurangan'])
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.amount is number && data.amount > 0
        && data.description is string && data.description.size() > 0 && data.description.size() <= 255
        && (!('sourceOrRecipient' in data) || (data.sourceOrRecipient is string && data.sourceOrRecipient.size() <= 150))
        && (!('recordedBy' in data) || (data.recordedBy is string && data.recordedBy.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidBusinessTransaction(data) {
      return data.keys().hasAll(['id', 'date', 'type', 'amount'])
        && data.keys().hasOnly(['id', 'unitKey', 'date', 'type', 'amount', 'description'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && data.type is string && data.type.size() > 0 && data.type.size() <= 50
        && data.amount is number && data.amount > 0
        && (!('unitKey' in data) || (data.unitKey is string && data.unitKey.size() <= 50))
        && (!('description' in data) || (data.description is string && data.description.size() <= 255));
    }

    // Rules for Members collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(memberId) && isValidMember(incoming()) && incoming().id == memberId;
      allow update: if isSignedIn() && isValidId(memberId) && isValidMember(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(memberId);
    }

    // Rules for Savings collection
    match /savings/{savingsId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(savingsId) && isValidSavings(incoming()) && incoming().id == savingsId;
      allow update: if isSignedIn() && isValidId(savingsId) && isValidSavings(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(savingsId);
    }

    // Rules for Loans collection
    match /loans/{loanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(loanId) && isValidLoan(incoming()) && incoming().id == loanId;
      allow update: if isSignedIn() && isValidId(loanId) && isValidLoan(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(loanId);
    }

    // Rules for Repayments collection
    match /repayments/{repaymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(repaymentId) && isValidRepayment(incoming()) && incoming().id == repaymentId;
      allow update: if isSignedIn() && isValidId(repaymentId) && isValidRepayment(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(repaymentId);
    }

    // Rules for CashFlow collection
    match /cashFlow/{cashFlowId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(cashFlowId) && isValidCashFlow(incoming()) && incoming().id == cashFlowId;
      allow update: if isSignedIn() && isValidId(cashFlowId) && isValidCashFlow(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(cashFlowId);
    }

    // Rules for SimpanPinjam Cash Mutations collection
    match /spCashMutations/{mutationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(mutationId) && isValidSpCashMutation(incoming()) && incoming().id == mutationId;
      allow update: if isSignedIn() && isValidId(mutationId) && isValidSpCashMutation(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(mutationId);
    }

    // Rules for Business Unit Transactions collection
    match /businessTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidBusinessTransaction(incoming()) && incoming().id == transactionId;
      allow update: if isSignedIn() && isValidId(transactionId) && isValidBusinessTransaction(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(transactionId);
    }
  }
}
